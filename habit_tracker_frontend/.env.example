# Habit Tracker Pro (frontend-only)
# Copy to .env if you want to override defaults.

# Base URLs (optional; app is local-only by default)
REACT_APP_API_BASE=
REACT_APP_BACKEND_URL=
REACT_APP_FRONTEND_URL=
REACT_APP_WS_URL=

# Feature flags (comma-separated). If empty, features default ON.
# Available flags:
# notifications,export_csv,export_pdf,analytics,gamification,pwa,demo_data
REACT_APP_FEATURE_FLAGS=notifications,export_csv,export_pdf,analytics,gamification,pwa,demo_data

# Optional knobs
REACT_APP_LOG_LEVEL=info
REACT_APP_NODE_ENV=development
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
